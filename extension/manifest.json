{
  "manifest_version": 3,
  "name": "AeroApply // Portal Autofill Assistant",
  "version": "1.0.0",
  "description": "1-Click autofill assistant for job application portals (Workday, Greenhouse, Personio, Lever, Taleo, etc.) for Chrome & Edge.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AeroApply Autofill Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
